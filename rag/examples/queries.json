      "gold": {
        "doc_globs": [
          "schemas/**/roles*.md",
          "schemas/**/permissions*.md",
          "schemas/**/rbac*.md"
        ]
      },
      "tags": ["rbac", "discovery"]
    },
    {
      "id": "q006",
